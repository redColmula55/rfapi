{
	"schemaVersion": 1,
	"id": "reservoir-api",
	"version": "${mod_version}+${minecraft_version}",
	"name": "Reservoir Fluid API",
	"description": "This is a lib mod which makes creating fluids in Fabric easier.",
	"authors": [
		"redColmula55"
	],
	"contact": {
		"homepage": "https://github.com/redColmula55/rfapi",
		"sources": "https://github.com/redColmula55/rfapi",
		"issues": "https://github.com/redColmula55/rfapi/issues"
	},
	"license": "LGPL-2.1 or later",
	"icon": "assets/reservoir-api/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "rc55.mc.rfapi.RFApiMain"
		],
		"client": [
          "rc55.mc.rfapi.RFApiClient"
		],
		"fabric-datagen": [
          "rc55.mc.rfapi.RFApiDataGenerator"
		],
        "modmenu": [
          "rc55.mc.rfapi.RFApiModMenuImpl"
        ]
	},
	"mixins": [
		"reservoir-api.mixins.json"
	],
	"accessWidener": "reservoir-api.accesswidener",
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
        "cloth-config": "*"
	},
	"custom": {
		"loom:injected_interfaces": {
          "net/minecraft/class_3611": ["rc55/mc/rfapi/fluid/IFluidWithSettings"],
          "net/minecraft/class_1297": ["rc55/mc/rfapi/entity/IFluidCollidable"]
		},
        "modmenu": {
            "badges": ["library"]
        }
	}
}
